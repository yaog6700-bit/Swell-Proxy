<UserControl
    x:Class="AnywhereWinUI.Controls.TrayPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Width="328">

    <UserControl.Resources>
        <!-- Inherits WinUI 3 SubtleButtonStyle hover/pressed states & ControlCornerRadius (4px) -->
        <Style x:Key="TrayFluentItemButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 1. Header: Status Indicator + WinUI Subtitle Typography + Master ToggleSwitch -->
        <Grid Padding="16,14,16,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         VerticalAlignment="Center"
                         Fill="{ThemeResource SystemFillColorNeutralBrush}" />
                <TextBlock x:Name="StatusTitleText"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           FontSize="18"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusModeSuffixText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,2" />
            </StackPanel>

            <ToggleSwitch x:Name="MasterProxyToggle"
                          Grid.Column="1"
                          OnContent=""
                          OffContent=""
                          MinWidth="0"
                          VerticalAlignment="Center"
                          Margin="0,-6,-12,-6"
                          Toggled="MasterProxyToggle_Toggled" />
        </Grid>

        <!-- 1.5 Official Fluent 2 Semantic Caution / Attention Banners (0 height when healthy) -->
        <Border x:Name="TamperBanner"
                Visibility="Collapsed"
                Margin="12,0,12,8"
                Padding="10,7"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <FontIcon Glyph="&#xE7BA;"
                          FontSize="14"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="TamperBannerText"
                           Grid.Column="1"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="RetakeProxyBtn"
                        Grid.Column="2"
                        Padding="8,3"
                        MinHeight="24"
                        FontSize="12"
                        Click="RetakeProxyBtn_Click" />
            </Grid>
        </Border>

        <Border x:Name="UpdateBanner"
                Visibility="Collapsed"
                Margin="12,0,12,8"
                Padding="10,7"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <FontIcon x:Name="UpdateBannerIcon"
                          Glyph="&#xE895;"
                          FontSize="14"
                          Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                          VerticalAlignment="Center" />
                <Button x:Name="UpdateTextBtn"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="2,1"
                        MinHeight="0"
                        MinWidth="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left"
                        VerticalAlignment="Center"
                        Click="UpdateTextBtn_Click">
                    <TextBlock x:Name="UpdateBannerText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Button>
                <ProgressBar x:Name="UpdateMiniProgressBar"
                             Grid.Column="2"
                             Visibility="Collapsed"
                             Width="54"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             VerticalAlignment="Center" />
                <Button x:Name="UpdateActionBtn"
                        Grid.Column="3"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="8,3"
                        MinHeight="24"
                        FontSize="12"
                        Click="UpdateActionBtn_Click" />
            </Grid>
        </Border>

        <!-- 2. Live Telemetry Strip (Segoe UI Variable + OpenType Tabular Numerals) -->
        <Grid Padding="16,0,16,12" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LiveSpeedText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TodayUsageText"
                       Grid.Column="1"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 3. Native WinUI 3 / CommunityToolkit Segmented Control: [ 规则 | 全局 | 直连 ] -->
        <Grid Padding="16,10,12,10" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="ModeLabelText"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />

            <tk:Segmented x:Name="ModeSegmented"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          SelectionChanged="ModeSegmented_SelectionChanged">
                <tk:SegmentedItem x:Name="ModeRuleItem" Tag="smart" />
                <tk:SegmentedItem x:Name="ModeGlobalItem" Tag="global" />
                <tk:SegmentedItem x:Name="ModeDirectItem" Tag="direct" />
            </tk:Segmented>
        </Grid>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 4. Quick Node Selector (Auto + Top 8 Nodes + All Nodes) -->
        <StackPanel Padding="6,8,6,8" Spacing="2">
            <Grid Padding="10,0,4,2" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="NodesSectionHeaderText"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="QuickPingBtn"
                        Grid.Column="1"
                        Style="{StaticResource SubtleButtonStyle}"
                        Padding="8,3"
                        MinHeight="24"
                        MinWidth="0"
                        Click="QuickPingBtn_Click">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE945;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="QuickPingBtnText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Auto (Fastest + Failover) Option with Win11 3px Accent Pill Indicator -->
            <Button x:Name="AutoSelectBtn"
                    Style="{StaticResource TrayFluentItemButtonStyle}"
                    Click="AutoSelectBtn_Click">
                <Grid ColumnDefinitions="12,*,Auto" ColumnSpacing="4">
                    <Border x:Name="AutoAccentBar"
                            Width="3"
                            Height="16"
                            CornerRadius="1.5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="Collapsed" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="AutoTitleText"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="AutoSubtitleText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="AutoResolvedNodeText"
                               Grid.Column="2"
                               MaxWidth="96"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Dynamic Top 8 Nodes -->
            <StackPanel x:Name="NodesStackPanel" Spacing="2" />

            <!-- All Nodes... Footer -->
            <Button x:Name="AllNodesBtn"
                    Style="{StaticResource TrayFluentItemButtonStyle}"
                    Click="AllNodesBtn_Click">
                <Grid ColumnDefinitions="12,*,Auto,Auto" ColumnSpacing="6">
                    <TextBlock x:Name="AllNodesLabelText"
                               Grid.Column="1"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="AllNodesCountText"
                               Grid.Column="2"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <FontIcon Grid.Column="3"
                              Glyph="&#xE76C;"
                              FontSize="10"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
