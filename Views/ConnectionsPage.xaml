<Page
    x:Class="AnywhereWinUI.Views.ConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AnywhereWinUI.Models"
    xmlns:mycontrols="using:AnywhereWinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14" Spacing="4">
            <TextBlock x:Uid="Conn_Title" Text="活动连接" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Uid="Conn_Subtitle" Text="实时监控并分析经过本地代理引擎的所有网络请求" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Quick Rule Feedback Toast -->
        <InfoBar Grid.Row="1"
                 Margin="0,0,0,12"
                 IsOpen="{x:Bind ViewModel.IsQuickRuleToastOpen, Mode=TwoWay}"
                 Severity="Success"
                 IsClosable="True"
                 Message="{x:Bind ViewModel.QuickRuleToastMessage, Mode=OneWay}"/>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ToggleCaptureCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{x:Bind ViewModel.CaptureButtonIcon, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource SystemAccentColorLight2}"/>
                        <TextBlock Text="{x:Bind ViewModel.CaptureButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearConnectionsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                        <TextBlock x:Uid="Conn_ClearText" Text="清空" />
                    </StackPanel>
                </Button>

                <!-- Active App Filter Pill -->
                <Button Command="{x:Bind ViewModel.ClearAppFilterCommand}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasAppFilter), Mode=OneWay}"
                        Padding="10,5"
                        CornerRadius="14"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource SystemAccentColor}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveAppFilterLabel, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <AutoSuggestBox x:Uid="Conn_SearchBox" Grid.Column="2" Width="260"
                            PlaceholderText="搜索域名、IP、应用或规则..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                            TextChanged="AutoSuggestBox_TextChanged"/>
        </Grid>

        <!-- Main Vertical Content: 1. Topology (Full Width) -> 2. App Ranking (Full Width) -> 3. Connections Table -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Spacing="16" Padding="0,0,0,8">

                <!-- Box 1 (Top): Topology Graph (Full Width, Original 280px Height) -->
                <Border Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xF6FA;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock x:Uid="Conn_TopologyHeader" Text="连接拓扑" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="ToggleTopologyButton_Click"
                                    Width="30"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                <FontIcon x:Name="TopologyChevronIcon" Glyph="&#xE70E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>
                        <mycontrols:TopologyGraphControl x:Name="TopologyGraphHost" Height="280" Margin="-20,0,-20,-20" />
                    </StackPanel>
                </Border>

                <!-- Box 2 (Middle): Per-App Traffic Ranking & One-Click Process Routing (Full Width) -->
                <Border Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <StackPanel Spacing="12">
                        <!-- App Ranking Header -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xECAA;" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock x:Uid="Conn_AppRankHeader" Text="谁在用 · 应用流量排行" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ActiveAppCountText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="3"
                                       x:Uid="Conn_AppRankHint"
                                       Text="点击应用筛选 · 右侧一键分流"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="4"
                                    Click="ToggleAppRankButton_Click"
                                    Width="30"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center">
                                <FontIcon x:Name="AppRankChevronIcon" Glyph="&#xE70E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <Grid x:Name="AppRankContentPanel">
                            <!-- Empty State -->
                            <StackPanel Visibility="{x:Bind InvertBoolToVisibility(ViewModel.HasAppRankings), Mode=OneWay}"
                                        Padding="0,18"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="6">
                                <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock x:Uid="Conn_AppRankEmpty"
                                           Text="暂无活跃应用连接"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- App Ranking List (Full Width) -->
                            <ListView Visibility="{x:Bind BoolToVisibility(ViewModel.HasAppRankings), Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.AppRankings, Mode=OneWay}"
                                      MaxHeight="210"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="AppRankingsListView_ItemClick"
                                      ShowsScrollingPlaceholders="False"
                                      Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="MinHeight" Value="40"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AppTrafficItem">
                                        <Grid ColumnDefinitions="220,90,*,1.2*,110,90,36" ColumnSpacing="12">
                                            <!-- Col 0: Process Name -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE756;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}"/>
                                                <TextBlock Text="{x:Bind AppName, Mode=OneWay}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Col 1: Connection Count Badge -->
                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ConnectionCountText, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontFamily="Consolas"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Border>

                                            <!-- Col 2: Primary Host -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind PrimaryHost, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <!-- Col 3: Share Progress Bar -->
                                            <ProgressBar Grid.Column="3"
                                                         Value="{x:Bind SharePercentage, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="6"
                                                         CornerRadius="3"
                                                         VerticalAlignment="Center"
                                                         Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"/>

                                            <!-- Col 4: Live Rate -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind RateText, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                            <!-- Col 5: Total Traffic -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{x:Bind TotalBytesText, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontFamily="Consolas"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <!-- Col 6: Quick Process Route Action -->
                                            <Button Grid.Column="6"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind CanAddProcessRule, Mode=OneWay}"
                                                    Click="AppQuickRouteButton_Click"
                                                    Width="30"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8AB;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Box 3 (Bottom): Connections List (Full Width) -->
                <Border Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Height="460">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Custom Header -->
                        <Grid Grid.Row="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="2.6*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="68"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="Conn_ColType" Grid.Column="0" Text="类型" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColProcess" Grid.Column="1" Text="应用 / 进程" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColHost" Grid.Column="2" Text="目标主机" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColNode" Grid.Column="3" Text="出站节点" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColRule" Grid.Column="4" Text="规则" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColRate" Grid.Column="5" Text="速率" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColSize" Grid.Column="6" Text="大小" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColDuration" Grid.Column="7" Text="耗时" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Uid="Conn_ColActions" Grid.Column="8" Text="操作" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.Connections, Mode=OneWay}"
                                  SelectionMode="Single"
                                  RightTapped="ConnectionsListView_RightTapped"
                                  ShowsScrollingPlaceholders="False"
                                  Padding="0,4">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,6" />
                                    <Setter Property="MinHeight" Value="38" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConnectionItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="2.6*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="145"/>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="68"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Type Badge -->
                                        <Border Grid.Column="0"
                                                Background="{x:Bind BadgeBackground, Mode=OneWay}"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Padding="6,2">
                                            <TextBlock Text="{x:Bind Type, Mode=OneWay}"
                                                       Foreground="{x:Bind BadgeForeground, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Consolas" />
                                        </Border>

                                        <!-- App / Process (Clickable to filter) -->
                                        <Button Grid.Column="1"
                                                Tag="{x:Bind}"
                                                Click="ProcessCellButton_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="4,2"
                                                Margin="-4,0,8,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ProcessName, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Button>

                                        <!-- Host -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Host, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <!-- Node -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind Node, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <!-- Rule -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind Rule, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <!-- Live Rate -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{x:Bind RateText, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="6"
                                                   Text="{x:Bind Size, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="7"
                                                   Text="{x:Bind Duration, Mode=OneWay}"
                                                   FontSize="11.5"
                                                   FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Quick Actions: Send via... + Close Connection -->
                                        <StackPanel Grid.Column="8"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Tag="{x:Bind}"
                                                    Click="ConnQuickRouteButton_Click"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                                <FontIcon Glyph="&#xE8AB;" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Button>
                                            <Button Tag="{x:Bind}"
                                                    Click="ConnCloseButton_Click"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0">
                                                <FontIcon Glyph="&#xE711;" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
