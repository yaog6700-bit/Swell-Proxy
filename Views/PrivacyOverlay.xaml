<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="AnywhereWinUI.Views.PrivacyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="600">

    <Grid Background="Transparent">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="20" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                MaxWidth="380"
                Padding="32,28">
            <StackPanel Spacing="24">
                <Viewbox Width="56" Height="56" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Viewbox>

                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="隐私保护模式已开启"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="操作界面已锁定，请输入解锁密码以继续"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <PasswordBox x:Name="PasswordInput"
                                 PlaceholderText="请输入解锁密码"
                                 KeyUp="PasswordInput_KeyUp"
                                 HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="ErrorText"
                               Text="密码错误，请重试"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed" />
                    <Button x:Name="UnlockButton"
                            Content="解锁"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="0,8"
                            Click="UnlockButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
