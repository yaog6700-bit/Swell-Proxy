<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AnywhereWinUI.Views.ClipboardToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE128;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Uid="ClipToast_Title" Text="检测到代理节点" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Uid="ClipToast_CloseBtn"
                    Grid.Column="1"
                    Click="CloseButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="28"
                    Height="28"
                    Padding="0"
                    ToolTipService.ToolTip="关闭"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE711;" FontSize="11" />
            </Button>
        </Grid>

        <TextBlock x:Name="NodeInfoText"
                   Grid.Row="1"
                   Text="类型: ... | 名称: ..."
                   Margin="24,8,0,12"
                   FontSize="13"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   MaxLines="2"
                   TextTrimming="CharacterEllipsis" />

        <Button x:Name="ImportButton"
                x:Uid="ClipToast_ImportBtn"
                Content="一键导入并测速 (Enter)"
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Style="{ThemeResource AccentButtonStyle}"
                Click="ImportButton_Click"
                CornerRadius="6" />
    </Grid>
</Window>
