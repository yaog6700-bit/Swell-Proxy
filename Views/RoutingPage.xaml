<Page
    x:Class="AnywhereWinUI.Views.RoutingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="Routing_Title" Text="分流规则" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Uid="Routing_Subtitle" Text="配置智能分流拦截规则，支持应用规则、自定义规则与顺序匹配" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1"
              MaxWidth="750"
              HorizontalAlignment="Left"
              RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Feature N5: Fluent 2 Routing Rule Hit Simulator Card (matches exact width of bottom card) -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,16"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <FontIcon Glyph="&#xE945;"
                                  FontSize="14"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="RouteSimHeaderText"
                                   Grid.Column="1"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBox x:Name="RouteSimInputBox"
                             HorizontalAlignment="Stretch"
                             TextChanged="RouteSimInputBox_TextChanged"/>

                    <Border x:Name="RouteSimResultPanel"
                            Visibility="Collapsed"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Padding="10,8"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border x:Name="RouteSimOutboundBadge"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RouteSimOutboundText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock x:Name="RouteSimMatchedRuleText"
                                       Grid.Column="1"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="RouteSimDnsText"
                                       Grid.Column="2"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,20">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="Routing_GroupTitle" Text="策略组配置" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="RuleCountText" Text="共 0 条规则，按列表顺序匹配" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Button x:Uid="Routing_ResetBtn"
                            Grid.Column="1"
                            Click="ResetRulesButton_Click"
                            Padding="10,6"
                            CornerRadius="6"
                            ToolTipService.ToolTip="恢复默认规则和默认顺序">
                        <FontIcon Glyph="&#xE777;" FontSize="13"/>
                    </Button>

                    <Button x:Uid="Routing_CustomRulesBtn"
                            Grid.Column="2"
                            Content="配置自定义规则"
                            Style="{ThemeResource AccentButtonStyle}"
                            FontSize="12"
                            Padding="14,6"
                            CornerRadius="6"
                            Click="AddRuleButton_Click"/>
                </Grid>

                <ListView x:Name="RulesListView"
                          Grid.Row="1"
                          SelectionMode="None"
                          CanDragItems="True"
                          CanReorderItems="True"
                          AllowDrop="True"
                          DragItemsCompleted="RulesListView_DragItemsCompleted"
                          ContainerContentChanging="RulesListView_ContainerContentChanging">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
